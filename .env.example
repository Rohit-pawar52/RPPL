APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Blank = use `tesseract` from PATH (all production/Linux setups need).
# Only set this to a full executable path if tesseract isn't on PATH
# for the running process (e.g. some local Windows setups).
TESSERACT_PATH=

# Firebase Cloud Messaging (push notifications, Phase B2) — PUBLIC Web
# config values only, never a secret, and never the private
# service-account credential (that belongs to a later phase and is never
# put in this file). Same Firebase project as the ShopStack reference
# app — copy its Web config values here. Leaving any of these blank
# simply keeps the public "Enable Notifications" control hidden; the
# rest of the site works normally either way. public/firebase-messaging-
# sw.js needs the SAME values hardcoded separately (a static file can't
# read these) — keep both in sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Firebase Cloud Messaging (push notifications) — the PRIVATE server-
# side service-account credential, never a public value, never
# committed. LEAVE THIS BLANK on every machine (dev, staging,
# production alike): if blank, AppServiceProvider::
# configureFirebaseCredentialsFallback() points kreait/laravel-firebase
# at storage_path('app/firebase/firebase-service-account.json')
# automatically, resolved fresh relative to wherever the app actually
# lives — never a hardcoded absolute path that would only work on one
# developer's machine and break on every other environment. Just place
# your downloaded service-account JSON at that one conventional path
# (storage/app/firebase/, already gitignored) and nothing else is
# needed. Only set this env var explicitly if a credential must live
# somewhere non-standard (e.g. a hosting platform that mounts secrets
# elsewhere) — an explicit value here always takes priority over the
# fallback. Without any credential configured, admin notification CRUD
# and Send/Resend still work (a zero-subscriber send always completes
# successfully; a non-zero send just fails safely and logs the error).
FIREBASE_CREDENTIALS=
